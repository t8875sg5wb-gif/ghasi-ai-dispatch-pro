          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "description": "UUID des Auftrags.",
              "type": "string"
            },
            "nummer": {
              "description": "Auftragsnummer, z.B. 'A-2026-0042'.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {

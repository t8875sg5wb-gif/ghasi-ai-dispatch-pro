# GHASI AI Executive — Environment example
# Copy to .env and fill in your own values.

# Supabase (Lovable Cloud backend)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Google Maps connector (browser)
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY="your-google-maps-browser-key"
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID="your-google-maps-tracking-id"
